# Copy to terraform.tfvars and fill in. Never commit the real file.
region     = "eu-west-1"
project    = "sl-cms"
environment = "staging"

# Signs preview and reset links. The value lives in Secrets Manager, not here: create the secret
# once and paste its ARN. (At least 32 characters; the command below makes 48.)
#
#   aws secretsmanager create-secret --name sl-cms/jwt-secret \
#     --secret-string "$(openssl rand -base64 48)"
jwt_secret_arn = "arn:aws:secretsmanager:eu-west-1:123456789012:secret:sl-cms/jwt-secret-AbCdEf"

# Who may become the first administrator by signing in.
bootstrap_admin_usernames = ["ops@example.com"]

cors_allowed_origins = ["https://cms.example.com"]
# Where the screen is served from: the provider sends the browser back to <app_url>/auth/callback,
# which is registered on the pool's client, and CloudFront answers on this name.
app_url = "https://cms.example.com"
# The certificate for that name. CloudFront reads certificates from us-east-1 whatever region the
# rest of the deployment is in; create it (with DNS validation) and paste its ARN. Pointing the
# name at `terraform output frontend_url` is the operator's, like the secret above.
frontend_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
# Where the preview site is served from: a name of its own, never a path under app_url. The app's
# origin keeps the editor's token in localStorage and the app never renders CMS HTML; a preview does
# render a draft, so it has to be a different origin (`doc/preview-site.md` §7). Leave this unset for
# the conventional `https://preview.<app_url's host>`. Point the name at `terraform output
# preview_url`, and set the site's own build to talk to `TSUBAME_URL` / the app's origin.
preview_url = "https://preview.cms.example.com"
# Only when frontend_certificate_arn does not already cover preview_url - a wildcard
# (`*.example.com`) or a certificate issued with both names covers both, and then this stays unset.
# preview_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
# "public" (a stable URL in content) or "presigned" (a private bucket, signed URLs: for a site that
# fetches images at build time and serves its own copies).
image_delivery = "public"

# Cognito's hosted page has to be unique across the whole region.
cognito_domain_prefix = "sl-cms-staging-example"
