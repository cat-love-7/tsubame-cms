# --- Rust (backend) ---
/backend/target/
**/target/

# Rust coverage report generated by cargo-llvm-cov / grcov
/backend/lcov.info

# Runtime application data (rkv datastore, uploaded images) created at startup. It lands next
# to whichever binary was run, which is a crate directory now that the workspace has four.
/backend/data/
/backend/crates/*/data/

# --- Node / Angular (frontend) ---
node_modules/
/dist/
/out-tsc/
/coverage/
.angular/cache/

# --- Local configuration ---
# The template is committed; a filled-in copy is not (it holds the signing key).
.env
.env.local

# --- Editors / OS ---
.DS_Store
Thumbs.db
.idea/
.history/
*.launch

# --- Migration run artifacts (scripts/migrate-from-strapi) ---
# The resume state names every Strapi id that became a CMS id, and the report quotes content;
# neither belongs in the repository.
**/.strapi-migration/

# --- Terraform (infra) ---
# `**/` so the bootstrap root (`infra/bootstrap/`) is covered by the same rules.
/infra/**/.terraform/
/infra/**/.terraform.lock.hcl
/infra/**/*.tfstate
/infra/**/*.tfstate.*
/infra/build/
/infra/terraform.tfvars
# The backend's per-deployment half; `infra/backend.hcl.example` is the shape.
/infra/backend.hcl
