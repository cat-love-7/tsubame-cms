# --- Rust (sl_cms) ---
/sl_cms/target/
**/target/

# Rust coverage report generated by cargo-llvm-cov / grcov
/sl_cms/lcov.info

# Runtime application data (rkv datastore, uploaded images) created at startup. It lands next
# to whichever binary was run, which is a crate directory now that the workspace has four.
/sl_cms/data/
/sl_cms/crates/*/data/

# --- Node / Angular (frontend/sl_cms) ---
node_modules/
/dist/
/out-tsc/
/coverage/
.angular/cache/

# --- Editors / OS ---
.DS_Store
Thumbs.db
.idea/
.history/
*.launch

# --- Terraform (infra) ---
# `**/` so the bootstrap root (`infra/bootstrap/`) is covered by the same rules.
/infra/**/.terraform/
/infra/**/.terraform.lock.hcl
/infra/**/*.tfstate
/infra/**/*.tfstate.*
/infra/build/
/infra/terraform.tfvars
# The backend's per-deployment half; `infra/backend.hcl.example` is the shape.
/infra/backend.hcl
