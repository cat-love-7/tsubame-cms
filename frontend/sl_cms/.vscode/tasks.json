{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      // Not a background task: the suite runs and exits, and its output is Vitest's, not the
      // bundle watcher's - so the matcher must not wait for a "bundle generation" line.
      "type": "npm",
      "script": "test",
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc"
      }
    }
  ]
}
