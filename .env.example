# Every setting the two binaries read, with the values a local run wants. Copy it to `.env` and
# load it (`set -a && . ./.env && set +a`), or pass the same names to `docker run --env-file`.
#
# The server reads its *environment*, not this file: there is no dotenv loader in the binary, and
# nothing here is read unless something exports it.

# ---------------------------------------------------------------- self-hosted (tsubame-on-premises)

# Signs session tokens and preview links. At least 32 characters, or the server refuses to start
# (a weak secret is a signing key someone else has). Generate one:
#   openssl rand -base64 48
JWT_SECRET=

# The first administrator, created when the user store is empty. Without these the server refuses
# to start rather than coming up with no way in. `ADMIN_EMAIL` is optional.
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-me
# ADMIN_EMAIL=

# Where the data goes: rkv/LMDB stores and the uploaded image files, created on first start.
DATA_ROOT=./data
# HOST=127.0.0.1
# PORT=8080

# Origins allowed to call the API from a browser. The admin app's dev server is the default.
# CORS_ALLOWED_ORIGINS=http://localhost:4200

# How long a session lasts, how long a preview link lasts, how long a password-reset link lasts.
# TOKEN_TTL_HOURS=12
# PREVIEW_LINK_TTL_MINUTES=60
# PASSWORD_RESET_TTL_MINUTES=30

# Where the admin screen sends a reviewer to read a preview (`/auth/capabilities` reports it).
# PREVIEW_SITE_URL=http://localhost:3000

# Content events, and the HMAC-SHA256 secret their bodies are signed with.
# WEBHOOK_URLS=https://example.com/hooks/content
# WEBHOOK_SECRET=

# Ceilings, in bytes. The defaults are 1 MiB for a JSON request, 10 MiB for one image and 4 MiB
# for one JSON response.
# MAX_REQUEST_BYTES=1048576
# MAX_IMAGE_BYTES=10485760
# MAX_RESPONSE_BYTES=4194304

# `RUST_LOG` is a tracing filter; `info` is the default.
# RUST_LOG=info

# ------------------------------------------------------------------------ AWS (tsubame-aws, Lambda)

# A deployment sets these through `infra/locals.tf`, not by hand; they are listed so a local run
# against the emulators can be set up the same way. `AWS_REGION` comes from the Lambda runtime in a
# deployment and cannot be set in its configuration.

# AWS_REGION=ap-northeast-1
# DYNAMODB_TABLE=tsubame-staging
# S3_BUCKET=tsubame-staging-images
# AWS_ENDPOINT_URL=http://127.0.0.1:8000          # DynamoDB Local
# AWS_ENDPOINT_URL_S3=http://127.0.0.1:9000       # the S3 emulator
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test-secret

# How an image's bytes are served: `public` (a stable address stored in content) or `presigned`
# (a private bucket and signed URLs). `AWS_IMAGE_BASE_URL` is a CDN in front of the bucket, and
# only means anything in the `public` mode.
# AWS_IMAGE_DELIVERY=public
# AWS_IMAGE_URL_TTL_SECONDS=3600
# AWS_IMAGE_BASE_URL=

# Cognito signs people in, and the first administrator of the pool is whoever signs in from this
# list (comma-separated).
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_LOGIN_URL=
# BOOTSTRAP_ADMIN_USERNAMES=

# The signing key, read from Secrets Manager at startup so the value is in neither the function's
# configuration nor the state file.
# JWT_SECRET_ARN=
